{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PORT=26251 BASE_PATH=/ NODE_ENV=production pnpm --filter @workspace/bond402 run build",
  "outputDirectory": "artifacts/bond402/dist/public",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://bond402-api.onrender.com/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://bond402-api.onrender.com/api/:path*"
    },
    {
      "source": "/mcp",
      "destination": "https://bond402-api.onrender.com/mcp"
    },
    {
      "source": "/mcp/",
      "destination": "https://bond402-api.onrender.com/mcp/"
    },
    {
      "source": "/oauth/authorize",
      "destination": "https://bond402-api.onrender.com/oauth/authorize"
    },
    {
      "source": "/oauth/authorize/decision",
      "destination": "https://bond402-api.onrender.com/oauth/authorize/decision"
    },
    {
      "source": "/oauth/token",
      "destination": "https://bond402-api.onrender.com/oauth/token"
    },
    {
      "source": "/oauth/register",
      "destination": "https://bond402-api.onrender.com/oauth/register"
    },
    {
      "source": "/oauth/revoke",
      "destination": "https://bond402-api.onrender.com/oauth/revoke"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "https://bond402-api.onrender.com/.well-known/oauth-authorization-server"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "https://bond402-api.onrender.com/.well-known/oauth-protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "https://bond402-api.onrender.com/.well-known/oauth-protected-resource/mcp"
    },
    {
      "source": "/mcp/.well-known/oauth-protected-resource",
      "destination": "https://bond402-api.onrender.com/mcp/.well-known/oauth-protected-resource"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://bond402-api.onrender.com/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}