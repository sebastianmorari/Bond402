{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:public-mvp": "pnpm --filter @workspace/api-server run build && node --test scripts/public-mvp.test.mjs",
    "test:headless-agent-e2e": "pnpm --filter @workspace/scripts exec tsx --test headless-agent-e2e.test.ts",
    "test:execution-gateway": "pnpm --filter @workspace/scripts exec tsx --test execution-gateway.test.ts",
    "test:execution-metadata": "node --experimental-strip-types --test scripts/execution-metadata.test.mjs",
    "test:real-reference-flow": "pnpm --filter @workspace/api-server run build && BOND402_REAL_REFERENCE_TEST=1 node --test scripts/real-reference-flow.test.mjs",
    "test:public-external-discovery": "node --experimental-strip-types --test scripts/public-external-discovery.test.mjs",
    "test:public-external-detail": "pnpm --filter @workspace/scripts exec tsx --test public-external-detail.test.ts",
    "test:public-external-routes": "pnpm --filter @workspace/scripts exec tsx --test public-external-routes.test.ts",
    "test:domain-verification": "pnpm --filter @workspace/scripts exec tsx --test domain-verification.test.mjs",
    "test:service-safety": "pnpm --filter @workspace/scripts exec tsx --test service-safety.test.mjs",
    "test:protected-api": "pnpm --filter @workspace/scripts exec tsx --test protected-api.test.mjs",
    "test:auth-session": "node --test scripts/auth-session.test.mjs",
    "test:database-resilience": "pnpm --filter @workspace/scripts exec tsx --test database-resilience.test.mjs",
    "test:backup-restore": "pnpm --filter @workspace/api-server run build && BOND402_BACKUP_RESTORE_TEST=1 node --test scripts/backup-restore.test.mjs",
    "test:secret-leak": "node --test scripts/secret-leak.test.mjs",
    "test:public-service-search": "node --experimental-strip-types --test scripts/public-service-search.test.mjs",
    "test:agent-decision": "pnpm --filter @workspace/scripts exec tsx --test agent-decision.test.ts",
    "test:public-internal-discovery": "pnpm --filter @workspace/scripts exec tsx --test public-internal-discovery.test.ts",
    "test:public-catalog-schema": "node --test scripts/public-catalog-schema.test.mjs",
    "test:response-mode": "pnpm --filter @workspace/scripts exec tsx --test response-mode.test.mjs",
    "test:security-signals": "pnpm --filter @workspace/scripts exec tsx --test security-signals.test.mjs",
    "test:service-registration": "pnpm --filter @workspace/scripts exec tsx --test service-registration-payload.test.mjs",
    "test:service-ui": "pnpm --filter @workspace/scripts exec tsx --test service-ui.test.mjs",
    "test:service-routes": "pnpm --filter @workspace/api-server run build && node --test scripts/service-routes.test.mjs",
    "test:trust-metrics": "pnpm --filter @workspace/scripts exec tsx --test trust-metrics.test.mjs",
    "test:trust-score": "pnpm --filter @workspace/scripts exec tsx --test trust-score.test.mjs",
    "test:frontend-smoke": "node --test scripts/frontend-smoke.test.mjs",
    "test:frontend-e2e": "node --test scripts/frontend-e2e.test.mjs",
    "test:frontend-seo": "PORT=4173 BASE_PATH=/ pnpm --filter @workspace/bond402 run build && node --test scripts/frontend-seo.test.mjs",
    "test:launch-gate": "node scripts/launch-gate.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
