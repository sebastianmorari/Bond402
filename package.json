{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "test:public-mvp": "pnpm --filter @workspace/api-server run build && node --test scripts/public-mvp.test.mjs",
    "test:domain-verification": "pnpm --filter @workspace/scripts exec tsx --test domain-verification.test.mjs",
    "test:service-safety": "pnpm --filter @workspace/scripts exec tsx --test service-safety.test.mjs",
    "test:protected-api": "pnpm --filter @workspace/scripts exec tsx --test protected-api.test.mjs",
    "test:response-mode": "pnpm --filter @workspace/scripts exec tsx --test response-mode.test.mjs",
    "test:service-ui": "pnpm --filter @workspace/scripts exec tsx --test service-ui.test.mjs",
    "test:service-routes": "pnpm --filter @workspace/api-server run build && node --test scripts/service-routes.test.mjs",
    "test:trust-metrics": "node --experimental-strip-types --test scripts/trust-metrics.test.mjs",
    "test:frontend-smoke": "node --test scripts/frontend-smoke.test.mjs",
    "test:frontend-seo": "PORT=4173 BASE_PATH=/ pnpm --filter @workspace/bond402 run build && node --test scripts/frontend-seo.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
